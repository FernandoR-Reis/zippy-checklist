# Crie um projeto em https://supabase.com e copie as chaves em
# Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Opcional: só necessário para o convite de usuários por e-mail
# (Project Settings > API > service_role). NUNCA exponha esta chave
# no client — ela só é usada em server actions.
SUPABASE_SERVICE_ROLE_KEY=
