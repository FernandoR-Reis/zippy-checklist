# Crie um projeto em https://supabase.com e copie as chaves em
# Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
NEXT_PUBLIC_SITE_URL=https://zippy-checklist.vercel.app

# Opcional: só necessário para o convite de usuários por e-mail
# (Project Settings > API > service_role). NUNCA exponha esta chave
# no client — ela só é usada em server actions.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push para os alertas de prazo dos checklists
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com
CHECKLIST_ALERTS_SECRET=
